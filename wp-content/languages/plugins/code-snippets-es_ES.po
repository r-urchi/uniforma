msgstr "«%s» estaba limitado por una condición en el sitio del que procedía. Las condiciones no se importan, por lo que una vez activado se ejecutará donde su ubicación lo permita."

#: php/Admin/Contextual_Help.php:331
msgid "The preview is private to the person testing it, and visitors are not shown the draft."
msgstr "La vista previa es privada para la persona que la prueba y el borrador no se muestra a los visitantes."

#: php/Admin/Contextual_Help.php:330
msgid "Preview tests a PHP, CSS, JavaScript or HTML snippet on a real page or admin screen before it is saved or activated."
msgstr "La vista previa prueba un fragmento de código de PHP, CSS, JavaScript o HTML en una página real o pantalla de administración antes de guardarlo o activarlo."

#: php/Admin/Contextual_Help.php:316
msgid "Items that cannot safely run as a snippet are listed as view only."
msgstr "Los elementos que no pueden ejecutarse de forma segura como un fragmento de código se muestran como de solo lectura."

#: php/Admin/Contextual_Help.php:315
msgid "Each item shows where it was found. Import items individually or in bulk; imported snippets are switched off until you activate them."
msgstr "Cada elemento muestra dónde se encontró. Importa elementos de forma individual o en lote; los fragmentos de código importados están desactivados hasta que los actives."

#: php/Admin/Contextual_Help.php:313
msgid "Importing Code"
msgstr "Importar código"

#: php/Admin/Contextual_Help.php:307
