{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/plugins.php",
	"steps": [
		{ "step": "defineWpConfigConsts", "consts": { "WP_DEBUG": true, "WP_DEBUG_DISPLAY": true, "WP_DEBUG_LOG": "/import/debug.log" } },
		{ "step": "runSql", "sql": { "resource": "vfs", "path": "/import/db-sqlite.sql" } },
		{ "step": "wp-cli", "command": "wp search-replace https://uniforma.com.ar http://127.0.0.1:9400 --all-tables --quiet" },
		{ "step": "wp-cli", "command": "wp user create local-admin local-admin@localhost.test --role=administrator --user_pass=admin" },
		{ "step": "login", "username": "local-admin", "password": "admin" }
	]
}
